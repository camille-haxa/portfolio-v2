---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Camille Haxa";
import { Image } from "astro:assets";
import avatar from "../assets/avatar4.png";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="intro-image">
    <Image src={avatar} alt="A colourful drawn portrait" class="avatar" />
  </div>
  <h2>Développeur web</h2>
</BaseLayout>

<style>
  .avatar {
    border-radius: 50%;
    width: 15rem;
    height: auto;
    margin: auto;
  }

  .intro-image {
    display: flex;
    padding-top: 2rem;
  }
</style>
